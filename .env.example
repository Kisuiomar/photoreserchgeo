# FindMyPhoto Configuration

# Number of top predictions to return from GeoCLIP
GEOCLIP_TOP_K=5

# Frontend port
PORT=8085

# Path to photo library on host
PHOTO_LIBRARY_PATH=./photos

# Enable Edit Mode (allows writing GPS to image files)
EDIT_MODE_ENABLED=true

# Auto-unload model after N seconds of inactivity (default: 600 = 10 min)
MODEL_IDLE_TIMEOUT=600

# Mapillary API credentials (optional, for street-level imagery)
MAPILLARY_TOKEN="your_mapillary_token"
MAPILLARY_CLIENT_ID="your_mapillary_client_id"

# Google Gemini API Key (for vision & text reading)
GEMINI_API_KEY="your_gemini_api_key"
