# WhereWasThisTaken? Configuration

# Number of top predictions to return from GeoCLIP
GEOCLIP_TOP_K=5

# Frontend port
PORT=9017

# Path to photo library on host
PHOTO_LIBRARY_PATH=./photos

# Enable Edit Mode (allows writing GPS to image files)
EDIT_MODE_ENABLED=false

# Auto-unload model after N seconds of inactivity (default: 600 = 10 min)
MODEL_IDLE_TIMEOUT=600
